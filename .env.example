# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# ----- Required -----
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ----- Google Calendar (enable_calendar = true) -----
GOOGLE_CREDENTIALS_FILE=credentials.json   # OAuth2 client secret file from Google Cloud Console
GOOGLE_TOKEN_FILE=token.json               # Generated automatically on first auth

# ----- Todoist (enable_todoist = true) -----
TODOIST_API_TOKEN=your-todoist-api-token-here

# ----- Telegram (enable_telegram = true) -----
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# ----- Lichess (enable_lichess = true) -----
# No auth required for public puzzle endpoint — no key needed
